# PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/farmtohome"
# Public base URL (used in QR codes and password-reset links)
APP_URL="https://farmtohome.example"
# 32+ random characters. Keys the HMAC used to store session, cart, reset and guest-order tokens.
# Generate with: openssl rand -base64 48
SESSION_SECRET=""
# Upload storage driver: "local" (public/uploads). Add an S3-compatible driver in src/server/storage.ts for multi-server deployments.
STORAGE_DRIVER="local"
# Mail/SMS driver: "console" logs messages (development). Add a provider in src/server/mail.ts for production.
MAIL_DRIVER="console"
