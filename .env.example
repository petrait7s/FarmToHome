# PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/farmtohome"
# Public base URL (used in QR codes, emails and password-reset links)
APP_URL="https://farmtohome.example"
# 32+ random characters; used to sign the CSRF-free double-submit values and future signed tokens
SESSION_SECRET=""
# Storage driver for uploads: "local" (public/uploads) or a future "s3"
STORAGE_DRIVER="local"
# Mail driver: "console" (development) or a future provider
MAIL_DRIVER="console"
